# Copia este archivo a backend/app/.env y completa los valores.
# Nunca subas .env al repositorio (ya está en .gitignore).

# Puerto del servidor Express
PORT=3000

# URI de conexión a MongoDB (Atlas o local). Requerida en producción.
# Ejemplo local: mongodb://127.0.0.1:27017/qrta
MONGO_URI=

# Clave secreta para firmar los JWT. Requerida en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS (URL del frontend). Requerida en producción.
# Ejemplo: https://qrta.co
FRONTEND_URL=http://localhost:5173

# Base URL que se codifica en los QR de las mesas (menú público).
# En producción usa tu dominio: https://menu.qrta.co
# En desarrollo usa la IP de tu máquina en la red local para que el celular pueda abrir el menú.
# Ejemplo: http://192.168.1.20:3000
QR_BASE_URL=

# development | production
NODE_ENV=development